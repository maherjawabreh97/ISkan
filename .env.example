# Admin dashboard
# Username/password for the seed admin account (created on first run only).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Secret used to sign the admin session cookie.
# REQUIRED in production. If unset, a random per-process secret is used and
# everyone is signed out on every restart.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=change-me-to-a-long-random-string

# Supabase (optional, recommended for hosted deployments)
# When both values below are set, listings, users and images are stored in
# Supabase instead of local files. Leave empty to keep the local-file storage.
SUPABASE_URL=
# Server-only secret. Never expose it to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for uploaded images (must match supabase/schema.sql).
SUPABASE_BUCKET=property-images
